# Disposable live-control overlay: ensure_overlay() copies the full Material
# Maker checkout (~266 MB, incl. a nested .git) here on first live-control use.
mm_live_overlay/

# Cookbook authoring: the builders (quality/cookbook_*.py) write variants to
# quality/authored/ and renders to quality/cookbook/; both regenerable.
# quality/promote_cookbook.py copies locked variants into the tracked cookbook/.
quality/authored/

# Cookbook growth (informal, non-frozen extensions like the fabric cases):
# same story, cookbook_fabrics.py regenerates the .ptex variants.
quality/cookbook/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Local Godot binary copied for host-side play.bat rendering (large, not tracked)
_godot/
