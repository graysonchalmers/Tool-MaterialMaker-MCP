# Copy to .env and set for your machine. The real .env is gitignored.

# Path to the Godot 4.7.x binary. Prefer the _console.exe build so render
# logs are captured; the plain GUI binary returns empty logs.
MM_GODOT_BINARY=C:\path\to\Godot_v4.7.1-stable_win64_console.exe

# Path to a Material Maker project checkout (contains project.godot, addons/, examples/).
# Needs steam_appid.txt (4110830) at its root or Material Maker relaunches itself and exits.
MM_PROJECT_PATH=C:\path\to\material-maker

# Where rendered maps and saved .ptex files go (defaults to ./output if unset).
MM_OUTPUT_DIR=C:\path\to\Tool-MaterialMaker-MCP\output

# Where the disposable live-control overlay is built (optional; defaults to
# ./mm_live_overlay under the current working directory if unset)
MM_LIVE_OVERLAY_DIR=

# Where the tracked cookbook of authored graphs lives (optional; defaults to
# the checkout's ./cookbook folder if unset; see cookbook/README.md)
MM_COOKBOOK_DIR=

# Port for the mm-play web page (optional; defaults to 8788)
MM_PLAY_PORT=
